<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Sma5hMusic.GUI.Views.MSBTFieldView">
  <UserControl.Styles>
    <Style Selector="ComboBox#TextColorComboBox">
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="Height" Value="26"/>
    </Style>
    <Style Selector="StackPanel#MsbtToolbar ComboBox">
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Height" Value="28"/>
    </Style>
    <Style Selector="TextBox#RichTextEditor">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="Transparent"/>
    </Style>
    <Style Selector="TextBox#RichTextEditor:pointerover">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="TextBox#RichTextEditor:focus">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
  </UserControl.Styles>
  <StackPanel>
    <StackPanel x:Name="MsbtToolbar" Orientation="Horizontal" Spacing="6">
      <ComboBox Classes="noBorder" Width="128" PlaceholderText="Select a language" SelectedItem="{Binding SelectedLocale}" Items="{Binding Locales}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ComboBox x:Name="RecentValuesComboBox" Classes="noBorder" Width="184" IsVisible="{Binding DisplayRecents}" PlaceholderText="Use Recent Values..." SelectedItem="{Binding SelectedRecentAction, Mode=TwoWay}" Items="{Binding UseRecent}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Converter={StaticResource LabelValueConverter}}" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ComboBox x:Name="TextColorComboBox" Classes="noBorder" IsVisible="{Binding EnableColorFormatting}" Width="108"
                SelectedItem="{Binding SelectedTextColor, Mode=TwoWay}" Items="{Binding TextColorOptions}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0">
              <Border Width="12" Height="12" Margin="0,0,5,0" Background="{Binding Hex}" BorderBrush="#777" BorderThickness="1" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ComboBox Classes="noBorder" Width="90" PlaceholderText="Copy..." SelectedItem="{Binding SelectedCopyAction, Mode=TwoWay}" Items="{Binding CopyActions}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </StackPanel>
    <TextBox IsVisible="{Binding !EnableColorFormatting}" Classes="jpnSupport" Text="{Binding CurrentLocalizedValue}" AcceptsReturn="{Binding AcceptsReturn}"/>
    <Grid IsVisible="{Binding EnableColorFormatting}">
      <Border x:Name="RichTextEditorFrame" BorderBrush="#777" BorderThickness="1" CornerRadius="2"
              Background="Transparent" MinHeight="28" Padding="4,5" Margin="0,1,0,0">
        <StackPanel x:Name="RichTextPreview" Orientation="Horizontal"/>
      </Border>
      <TextBox x:Name="RichTextEditor" Classes="jpnSupport" AcceptsReturn="{Binding AcceptsReturn}"/>
    </Grid>
  </StackPanel>
</UserControl>
