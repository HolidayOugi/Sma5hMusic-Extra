<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Sma5hMusic.GUI.Views.Fields.PropertyTextField">
  <StackPanel Classes="propertyField">
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="{Binding $parent[UserControl].Label}"/>
      <TextBlock Classes="required" IsVisible="{Binding $parent[UserControl].IsRequired}" Text="*"/>
      <TextBlock Text="&#128712;" Classes="tooltip" ToolTip.Tip="{Binding $parent[UserControl].ToolTip}"/>
    </StackPanel>
    <Grid ColumnDefinitions="*,Auto">
      <TextBox AcceptsReturn="{Binding $parent[UserControl].AcceptsReturn}" IsReadOnly="{Binding $parent[UserControl].IsReadOnly}" Text="{Binding $parent[UserControl].Text}"></TextBox>
      <Button Grid.Column="1"
              Content="{Binding $parent[UserControl].ButtonContent}"
              Command="{Binding $parent[UserControl].ButtonCommand}"
              CommandParameter="{Binding $parent[UserControl].ButtonCommandParameter}"
              IsVisible="{Binding $parent[UserControl].IsButtonVisible}"
              VerticalAlignment="Stretch"
              Margin="8,0,8,0"/>
    </Grid>
    <TextBlock Classes="error" Text="{Binding $parent[UserControl].ValidationError}"/>
  </StackPanel>
</UserControl>
