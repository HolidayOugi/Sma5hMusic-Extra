<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="560"
        Width="460" Height="560" MinWidth="400" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        x:Class="Sma5hMusic.GUI.Views.DefaultColorListModalWindow"
        Title="Modify Default Color List">
  <DockPanel Classes="modal" LastChildFill="True" HorizontalAlignment="Stretch">
    <Border Classes="headerTitle" DockPanel.Dock="Top">
      <TextBlock>Modify Default Color List</TextBlock>
    </Border>
    <StackPanel Classes="modalActions" DockPanel.Dock="Bottom">
      <Button x:Name="SaveButton" Content="Save"></Button>
      <Button x:Name="CancelButton" Content="Cancel"></Button>
    </StackPanel>
    <DockPanel Classes="content">
      <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,10">
        <Button x:Name="AddButton" Content="Add Color" HorizontalAlignment="Left"/>
        <TextBlock x:Name="ValidationText" Classes="error" TextWrapping="Wrap"/>
      </StackPanel>
      <Grid>
        <TextBlock x:Name="EmptyText" Text="No default colors configured."
                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="ColorsPanel" Spacing="6"/>
        </ScrollViewer>
      </Grid>
    </DockPanel>
  </DockPanel>
</Window>
